{
  "name": "commit-dsa-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "format": "prettier --write \"{client,server}/src/**/*.{ts,tsx,css}\" \"client/index.html\"",
    "format:check": "prettier --check \"{client,server}/src/**/*.{ts,tsx,css}\" \"client/index.html\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server test",
    "lint": "npm --prefix server run lint && npm --prefix client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.8"
  }
}
