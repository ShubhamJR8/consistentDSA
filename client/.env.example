# Where the browser sends API requests. Leave unset to use the same-origin /api path (what the Vite dev
# proxy and a reverse proxy in front of both apps provide). Set it when the API lives on its own origin,
# e.g. https://api.example.com/api — the server must then list this site as CLIENT_URL (CORS + CSRF
# origin check), and cookies are SameSite=None; Secure in production, so both sites need https.
VITE_API_BASE_URL=
