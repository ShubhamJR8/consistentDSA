PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/commit_dsa
# Leave unset in dev (a fallback is used). Required in production — boot fails without a real
# 32+ char value. Generate one with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Judge0 Cloud (RapidAPI) — https://rapidapi.com/judge0-official/api/judge0-ce
# Leave unset to run without the in-editor judge; self-reported completion still works.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# LeetCode verification — no credentials needed. Uses Alfa (alfa-leetcode-api), an UNOFFICIAL
# third-party wrapper over LeetCode's public data: availability and permitted use are not
# guaranteed. Alfa caps accepted-submission history at 20 entries. The sweep needs a long-running
# server process; on serverless/cron-only hosts call runLeetCodeVerificationSweep from a scheduled job.
LEETCODE_VERIFICATION_ENABLED=false
LEETCODE_VERIFICATION_INTERVAL_MINUTES=5
LEETCODE_API_BASE_URL=https://alfa-leetcode-api.onrender.com
LEETCODE_API_TIMEOUT_MS=15000
LEETCODE_API_MAX_ATTEMPTS=3
LEETCODE_SUBMISSIONS_LIMIT=20
LEETCODE_CACHE_TTL_SECONDS=30
# Minutes after a day's deadline before an unverified LeetCode day is marked missed (verified-account
# users only), and the hard cap if the last check was inconclusive. Needs the sweep or manual checks.
LEETCODE_GRACE_MINUTES=30
LEETCODE_GRACE_OUTAGE_MAX_HOURS=6
LEETCODE_CHALLENGE_TTL_MINUTES=10
LEETCODE_CHALLENGE_RATE_LIMIT=5
LEETCODE_VERIFY_RATE_LIMIT=10

# Razorpay test mode — Dashboard > Settings > API Keys > Generate Test Key. No KYC needed for
# test keys. Leave unset to run without real payments (commitments can still be activated via
# the dev-only /dev-activate route in non-production environments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: URL https://<api-host>/api/payments/webhook, events payment.captured
# and order.paid, with this secret. Required in production when Razorpay is enabled.
RAZORPAY_WEBHOOK_SECRET=
# Sweep that asks Razorpay about deposits still PENDING after MIN_AGE and activates captured ones
# (activation only — no refunds). Active only when the Razorpay keys are set.
PAYMENT_RECONCILIATION_INTERVAL_MINUTES=10
PAYMENT_RECONCILIATION_MIN_AGE_MINUTES=10

# How often the background sweep finalizes ACTIVE commitments past their last day (status only —
# it never calls Razorpay). Refunds are queued automatically but only ever executed by hand via
# `npm run refunds:list` / `refunds:execute`.
COMMITMENT_SETTLEMENT_INTERVAL_MINUTES=15

# Generic SMTP for password-reset and email-verification links — any provider works (Gmail app
# password, SES, SendGrid, Resend, etc). Leave unset to run without email: links are logged to
# the server console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CommitDSA <no-reply@commitdsa.app>
